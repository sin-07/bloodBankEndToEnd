# ==============================================================================
# Srishti Blood Bank - Environment Template (.env.example)
# Duplicate this file to .env.local and populate with your credentials.
# ==============================================================================

# MongoDB Connection String (Atlas SRV URI or direct replica set URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.sce5pri.mongodb.net/BloodBank?retryWrites=true&w=majority&appName=Cluster0

# JWT Authentication
JWT_SECRET=generate_a_random_secure_secret_here
JWT_EXPIRE=7d

# Email Notification Service (Nodemailer / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=notifications@srishtibloodbank.org

# Cloudinary Storage (Optional - for prescriptions & documents)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Application Metadata
NEXT_PUBLIC_APP_NAME=Srishti Blood Bank
NEXT_PUBLIC_APP_URL=http://localhost:3000
